@@ -0,0 +1,40 @@
+/**
+ * A one-shot release / status announcement under the welcome panel, modelled on
+ * the Kimi home screen: a rendered star glyph (not an emoji), a bold headline
+ * and an optional dim detail line.
+ */
+
+import { truncateToWidth, type Component } from '@loophole/tui-engine';
+
+import { currentTheme } from '../../theme/index';
+
+export interface AnnouncementState {
+  readonly title: string;
+  readonly detail?: string;
+  /** Hide the whole block (the default before the controller publishes one). */
+  readonly visible?: boolean;
+}
+
+export class AnnouncementComponent implements Component {
+  private state: AnnouncementState;
+
+  constructor(state: AnnouncementState = { title: '', visible: false }) {
+    this.state = state;
+  }
+
+  update(state: AnnouncementState): void {
+    this.state = state;
+  }
+
+  invalidate(): void {}
+
+  render(width: number): string[] {
+    if (this.state.visible === false || this.state.title.length === 0) return [];
+    const star = currentTheme.fg('primary', '✦');
+    const lines = ['', truncateToWidth(`  ${star} ${currentTheme.boldFg('textStrong', this.state.title)}`, width, '…')];
+    if (this.state.detail) {
+      lines.push(truncateToWidth(`    ${currentTheme.fg('textDim', this.state.detail)}`, width, '…'));
+    }
+    return lines;
+  }
+}
