+  scored.sort((a, b) => {
+    if (a.score !== b.score) return b.score - a.score;
+    if (a.candidate.isDirectory !== b.candidate.isDirectory) {
+      return a.candidate.isDirectory ? -1 : 1;
+    }
+    return a.candidate.path.localeCompare(b.candidate.path);
+  });
