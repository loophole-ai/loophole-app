+			if (!isRelease) this.scrollToTop();
+			return { consume: true };
+		}
+		if (primaryScrollable && keybindings.matches(data, "tui.altScreen.bottom")) {
+			if (!isRelease) this.scrollToBottom();
+			return { consume: true };
+		}
+		return undefined;
+	}
