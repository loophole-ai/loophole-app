{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@loophole/tui-engine",
	"version": "1.0.0",
	"description": "Terminal UI engine (differential rendering). Vendored from the Moonshot AI pi-tui fork of earendil-works/pi packages/tui.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"main": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "bun check --no-script -b",
		"typecheck:tsc": "tsc -b"
	},
	"dependencies": {
		"get-east-asian-width": "catalog:",
		"marked": "catalog:",
		"marked-cjk-friendly": "0.1.2"
	},
	"devDependencies": {
		"@tsconfig/bun": "catalog:",
		"@types/bun": "catalog:",
		"@typescript/native": "catalog:",
		"chalk": "5.6.2"
	}
}
