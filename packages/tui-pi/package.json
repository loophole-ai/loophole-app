{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@loophole/tui-pi",
	"version": "1.0.0",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"private": true,
	"main": "src/index.ts",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"typecheck": "bun check --no-script -b",
		"typecheck:tsc": "tsc -b"
	},
	"files": [
		"src/**/*",
		"native/napi.h",
		"native/clipboard.h",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"native/linux/README.md",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Loophole",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/loophole/loophole-app",
		"directory": "packages/tui-pi"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"dependencies": {
		"get-east-asian-width": "catalog:",
		"marked": "catalog:",
		"marked-cjk-friendly": "0.1.2"
	},
	"devDependencies": {
		"@tsconfig/bun": "catalog:",
		"@types/bun": "catalog:",
		"@typescript/native": "catalog:",
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2"
	}
}
