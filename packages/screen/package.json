{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@loophole/screen",
	"version": "1.0.0",
	"description": "Loophole terminal screen: components, theme and layout (derived from the MIT-licensed Moonshot AI kimi-code TUI).",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"main": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "bun check --no-script -b",
		"typecheck:tsc": "tsc -b"
	},
	"dependencies": {
		"@loophole/tui-engine": "workspace:*",
		"chalk": "5.6.2",
		"cli-highlight": "2.1.11"
	},
	"devDependencies": {
		"@tsconfig/bun": "catalog:",
		"@types/bun": "catalog:",
		"@typescript/native": "catalog:"
	}
}
